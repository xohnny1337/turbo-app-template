{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "expo start --dev-client",
    "tunnel": "expo start --dev-client --tunnel",
    "ios": "eas build --profile development --platform ios",
    "ios:prod": "node scripts/increment-build.js ios && eas build --platform ios",
    "android": "eas build --profile development --platform android",
    "android:prod": "node scripts/increment-build.js android && eas build --platform android",
    "prebuild": "expo prebuild",
    "lint": "expo lint --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/auth": "^26.4.0",
    "@react-native-firebase/firestore": "^26.4.0",
    "@repo/theme": "workspace:*",
    "@repo/types": "workspace:*",
    "date-fns": "^4.4.0",
    "expo": "~57.0.22",
    "expo-application": "~57.0.3",
    "expo-build-properties": "~57.0.17",
    "expo-constants": "~57.0.18",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.22",
    "expo-web-browser": "~57.0.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-purchases": "10.9.1",
    "react-native-purchases-ui": "10.9.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "twrnc": "^4.16.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:"
