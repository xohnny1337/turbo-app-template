{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "expo start --dev-client",
    "tunnel": "expo start --dev-client --tunnel",
    "ios": "eas build --profile development --platform ios",
    "ios:prod": "node scripts/increment-build.js ios && eas build --platform ios",
    "android": "eas build --profile development --platform android",
    "android:prod": "node scripts/increment-build.js android && eas build --platform android",
    "prebuild": "expo prebuild",
    "lint": "expo lint --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-firebase/app": "^27.1.1",
    "@react-native-firebase/auth": "^27.1.1",
    "@react-native-firebase/firestore": "^27.1.1",
    "@repo/theme": "workspace:*",
    "@repo/types": "workspace:*",
    "date-fns": "^4.4.0",
    "expo": "~58.0.25",
    "expo-application": "~58.1.2",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.20",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.22",
    "expo-web-browser": "~58.0.8",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-purchases": "11.0.2",
    "react-native-purchases-ui": "11.0.2",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "twrnc": "^4.16.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
