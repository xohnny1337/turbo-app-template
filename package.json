{
  "name": "my-app",
  "private": true,
  "scripts": {
    "configure": "node scripts/setup.mjs",
    "postinstall": "node scripts/setup-reminder.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "ios": "turbo run ios",
    "ios:prod": "turbo run ios:prod",
    "android": "turbo run android",
    "android:prod": "turbo run android:prod",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "clean": "rm -rf node_modules apps/*/node_modules apps/*/.turbo apps/*/.expo apps/*/dist apps/*/ios apps/*/android packages/*/node_modules pnpm-lock.yaml"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.10.13",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  }
}
